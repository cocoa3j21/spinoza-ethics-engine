    },
    {
      "id": "PROP_7",
      "type": "proposition",
      "title": "実体の必然的存在性",
      "text_ja": "実体の本性には存在することが属する（実体は自己原因であり必然的に存在する）。",
      "dependencies": [
        "PROP_6",
        "DEF_1"
      ],
      "logical_form": "Substance(x) -> (Causa_sui(x) and Exists(x))",
      "dependencies_detailed": [
