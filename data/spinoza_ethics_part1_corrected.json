        }
      ]
    },
    {
      "id": "PROP_6",
      "type": "proposition",
      "title": "実体の他者産出不能性",
      "text_ja": "一つの実体は他の実体から産出されることはあり得ない。",
      "dependencies": [
        "PROP_2",
        "PROP_3",
        "PROP_5"
